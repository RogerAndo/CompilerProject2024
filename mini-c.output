Grammar

    0 $accept: line $end

    1 line: /* empty */
    2     | line item

    3 item: declaration EOL
    4     | statement EOL

    5 declaration: INT id
    6            | FLOAT id

    7 statement: id ASSIGN expr
    8          | expr

    9 expr: INUM
   10     | FNUM
   11     | id
   12     | expr PLUS expr
   13     | expr MINUS expr
   14     | expr MUL expr
   15     | expr DIV expr
   16     | LP expr RP
   17     | MINUS expr

   18 id: ID


Terminals, with rules where they appear

$end (0) 0
error (256)
INUM (258) 9
FNUM (259) 10
ID (260) 18
INT (261) 5
FLOAT (262) 6
PLUS (263) 12
MINUS (264) 13 17
MUL (265) 14
DIV (266) 15
LP (267) 16
RP (268) 16
ASSIGN (269) 7
EOL (270) 3 4
SIGN (271)


Nonterminals, with rules where they appear

$accept (17)
    on left: 0
line (18)
    on left: 1 2, on right: 0 2
item (19)
    on left: 3 4, on right: 2
declaration (20)
    on left: 5 6, on right: 3
statement (21)
    on left: 7 8, on right: 4
expr (22)
    on left: 9 10 11 12 13 14 15 16 17, on right: 7 8 12 13 14 15 16
    17
id (23)
    on left: 18, on right: 5 6 7 11


state 0

    0 $accept: . line $end

    $default  reduce using rule 1 (line)

    line  go to state 1


state 1

    0 $accept: line . $end
    2 line: line . item

    $end   shift, and go to state 2
    INUM   shift, and go to state 3
    FNUM   shift, and go to state 4
    ID     shift, and go to state 5
    INT    shift, and go to state 6
    FLOAT  shift, and go to state 7
    MINUS  shift, and go to state 8
    LP     shift, and go to state 9

    item         go to state 10
    declaration  go to state 11
    statement    go to state 12
    expr         go to state 13
    id           go to state 14


state 2

    0 $accept: line $end .

    $default  accept


state 3

    9 expr: INUM .

    $default  reduce using rule 9 (expr)


state 4

   10 expr: FNUM .

    $default  reduce using rule 10 (expr)


state 5

   18 id: ID .

    $default  reduce using rule 18 (id)


state 6

    5 declaration: INT . id

    ID  shift, and go to state 5

    id  go to state 15


state 7

    6 declaration: FLOAT . id

    ID  shift, and go to state 5

    id  go to state 16


state 8

   17 expr: MINUS . expr

    INUM   shift, and go to state 3
    FNUM   shift, and go to state 4
    ID     shift, and go to state 5
    MINUS  shift, and go to state 8
    LP     shift, and go to state 9

    expr  go to state 17
    id    go to state 18


state 9

   16 expr: LP . expr RP

    INUM   shift, and go to state 3
    FNUM   shift, and go to state 4
    ID     shift, and go to state 5
    MINUS  shift, and go to state 8
    LP     shift, and go to state 9

    expr  go to state 19
    id    go to state 18


state 10

    2 line: line item .

    $default  reduce using rule 2 (line)


state 11

    3 item: declaration . EOL

    EOL  shift, and go to state 20


state 12

    4 item: statement . EOL

    EOL  shift, and go to state 21


state 13

    8 statement: expr .
   12 expr: expr . PLUS expr
   13     | expr . MINUS expr
   14     | expr . MUL expr
   15     | expr . DIV expr

    PLUS   shift, and go to state 22
    MINUS  shift, and go to state 23
    MUL    shift, and go to state 24
    DIV    shift, and go to state 25

    $default  reduce using rule 8 (statement)


state 14

    7 statement: id . ASSIGN expr
   11 expr: id .

    ASSIGN  shift, and go to state 26

    $default  reduce using rule 11 (expr)


state 15

    5 declaration: INT id .

    $default  reduce using rule 5 (declaration)


state 16

    6 declaration: FLOAT id .

    $default  reduce using rule 6 (declaration)


state 17

   12 expr: expr . PLUS expr
   13     | expr . MINUS expr
   14     | expr . MUL expr
   15     | expr . DIV expr
   17     | MINUS expr .

    $default  reduce using rule 17 (expr)


state 18

   11 expr: id .

    $default  reduce using rule 11 (expr)


state 19

   12 expr: expr . PLUS expr
   13     | expr . MINUS expr
   14     | expr . MUL expr
   15     | expr . DIV expr
   16     | LP expr . RP

    PLUS   shift, and go to state 22
    MINUS  shift, and go to state 23
    MUL    shift, and go to state 24
    DIV    shift, and go to state 25
    RP     shift, and go to state 27


state 20

    3 item: declaration EOL .

    $default  reduce using rule 3 (item)


state 21

    4 item: statement EOL .

    $default  reduce using rule 4 (item)


state 22

   12 expr: expr PLUS . expr

    INUM   shift, and go to state 3
    FNUM   shift, and go to state 4
    ID     shift, and go to state 5
    MINUS  shift, and go to state 8
    LP     shift, and go to state 9

    expr  go to state 28
    id    go to state 18


state 23

   13 expr: expr MINUS . expr

    INUM   shift, and go to state 3
    FNUM   shift, and go to state 4
    ID     shift, and go to state 5
    MINUS  shift, and go to state 8
    LP     shift, and go to state 9

    expr  go to state 29
    id    go to state 18


state 24

   14 expr: expr MUL . expr

    INUM   shift, and go to state 3
    FNUM   shift, and go to state 4
    ID     shift, and go to state 5
    MINUS  shift, and go to state 8
    LP     shift, and go to state 9

    expr  go to state 30
    id    go to state 18


state 25

   15 expr: expr DIV . expr

    INUM   shift, and go to state 3
    FNUM   shift, and go to state 4
    ID     shift, and go to state 5
    MINUS  shift, and go to state 8
    LP     shift, and go to state 9

    expr  go to state 31
    id    go to state 18


state 26

    7 statement: id ASSIGN . expr

    INUM   shift, and go to state 3
    FNUM   shift, and go to state 4
    ID     shift, and go to state 5
    MINUS  shift, and go to state 8
    LP     shift, and go to state 9

    expr  go to state 32
    id    go to state 18


state 27

   16 expr: LP expr RP .

    $default  reduce using rule 16 (expr)


state 28

   12 expr: expr . PLUS expr
   12     | expr PLUS expr .
   13     | expr . MINUS expr
   14     | expr . MUL expr
   15     | expr . DIV expr

    MUL  shift, and go to state 24
    DIV  shift, and go to state 25

    $default  reduce using rule 12 (expr)


state 29

   12 expr: expr . PLUS expr
   13     | expr . MINUS expr
   13     | expr MINUS expr .
   14     | expr . MUL expr
   15     | expr . DIV expr

    MUL  shift, and go to state 24
    DIV  shift, and go to state 25

    $default  reduce using rule 13 (expr)


state 30

   12 expr: expr . PLUS expr
   13     | expr . MINUS expr
   14     | expr . MUL expr
   14     | expr MUL expr .
   15     | expr . DIV expr

    $default  reduce using rule 14 (expr)


state 31

   12 expr: expr . PLUS expr
   13     | expr . MINUS expr
   14     | expr . MUL expr
   15     | expr . DIV expr
   15     | expr DIV expr .

    $default  reduce using rule 15 (expr)


state 32

    7 statement: id ASSIGN expr .
   12 expr: expr . PLUS expr
   13     | expr . MINUS expr
   14     | expr . MUL expr
   15     | expr . DIV expr

    PLUS   shift, and go to state 22
    MINUS  shift, and go to state 23
    MUL    shift, and go to state 24
    DIV    shift, and go to state 25

    $default  reduce using rule 7 (statement)
