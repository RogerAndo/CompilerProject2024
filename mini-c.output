Grammar

    0 $accept: line $end

    1 line: /* empty */
    2     | line item

    3 item: declaration EOL
    4     | statement EOL

    5 declaration: INT id
    6            | FLOAT id
    7            | INT id ASSIGN INUM
    8            | FLOAT id ASSIGN FNUM
    9            | FLOAT id ASSIGN INUM

   10 statement: id ASSIGN expr
   11          | PRINT expr

   12 expr: INUM
   13     | FNUM
   14     | id
   15     | expr PLUS expr
   16     | expr MINUS expr
   17     | expr MUL expr
   18     | expr DIV expr
   19     | LP expr RP
   20     | MINUS expr

   21 id: ID


Terminals, with rules where they appear

$end (0) 0
error (256)
INUM (258) 7 9 12
FNUM (259) 8 13
ID (260) 21
INT (261) 5 7
FLOAT (262) 6 8 9
PLUS (263) 15
MINUS (264) 16 20
MUL (265) 17
DIV (266) 18
LP (267) 19
RP (268) 19
ASSIGN (269) 7 8 9 10
EOL (270) 3 4
PRINT (271) 11
SIGN (272)


Nonterminals, with rules where they appear

$accept (18)
    on left: 0
line (19)
    on left: 1 2, on right: 0 2
item (20)
    on left: 3 4, on right: 2
declaration (21)
    on left: 5 6 7 8 9, on right: 3
statement (22)
    on left: 10 11, on right: 4
expr (23)
    on left: 12 13 14 15 16 17 18 19 20, on right: 10 11 15 16 17 18
    19 20
id (24)
    on left: 21, on right: 5 6 7 8 9 10 14


state 0

    0 $accept: . line $end

    $default  reduce using rule 1 (line)

    line  go to state 1


state 1

    0 $accept: line . $end
    2 line: line . item

    $end   shift, and go to state 2
    ID     shift, and go to state 3
    INT    shift, and go to state 4
    FLOAT  shift, and go to state 5
    PRINT  shift, and go to state 6

    item         go to state 7
    declaration  go to state 8
    statement    go to state 9
    id           go to state 10


state 2

    0 $accept: line $end .

    $default  accept


state 3

   21 id: ID .

    $default  reduce using rule 21 (id)


state 4

    5 declaration: INT . id
    7            | INT . id ASSIGN INUM

    ID  shift, and go to state 3

    id  go to state 11


state 5

    6 declaration: FLOAT . id
    8            | FLOAT . id ASSIGN FNUM
    9            | FLOAT . id ASSIGN INUM

    ID  shift, and go to state 3

    id  go to state 12


state 6

   11 statement: PRINT . expr

    INUM   shift, and go to state 13
    FNUM   shift, and go to state 14
    ID     shift, and go to state 3
    MINUS  shift, and go to state 15
    LP     shift, and go to state 16

    expr  go to state 17
    id    go to state 18


state 7

    2 line: line item .

    $default  reduce using rule 2 (line)


state 8

    3 item: declaration . EOL

    EOL  shift, and go to state 19


state 9

    4 item: statement . EOL

    EOL  shift, and go to state 20


state 10

   10 statement: id . ASSIGN expr

    ASSIGN  shift, and go to state 21


state 11

    5 declaration: INT id .
    7            | INT id . ASSIGN INUM

    ASSIGN  shift, and go to state 22

    $default  reduce using rule 5 (declaration)


state 12

    6 declaration: FLOAT id .
    8            | FLOAT id . ASSIGN FNUM
    9            | FLOAT id . ASSIGN INUM

    ASSIGN  shift, and go to state 23

    $default  reduce using rule 6 (declaration)


state 13

   12 expr: INUM .

    $default  reduce using rule 12 (expr)


state 14

   13 expr: FNUM .

    $default  reduce using rule 13 (expr)


state 15

   20 expr: MINUS . expr

    INUM   shift, and go to state 13
    FNUM   shift, and go to state 14
    ID     shift, and go to state 3
    MINUS  shift, and go to state 15
    LP     shift, and go to state 16

    expr  go to state 24
    id    go to state 18


state 16

   19 expr: LP . expr RP

    INUM   shift, and go to state 13
    FNUM   shift, and go to state 14
    ID     shift, and go to state 3
    MINUS  shift, and go to state 15
    LP     shift, and go to state 16

    expr  go to state 25
    id    go to state 18


state 17

   11 statement: PRINT expr .
   15 expr: expr . PLUS expr
   16     | expr . MINUS expr
   17     | expr . MUL expr
   18     | expr . DIV expr

    PLUS   shift, and go to state 26
    MINUS  shift, and go to state 27
    MUL    shift, and go to state 28
    DIV    shift, and go to state 29

    $default  reduce using rule 11 (statement)


state 18

   14 expr: id .

    $default  reduce using rule 14 (expr)


state 19

    3 item: declaration EOL .

    $default  reduce using rule 3 (item)


state 20

    4 item: statement EOL .

    $default  reduce using rule 4 (item)


state 21

   10 statement: id ASSIGN . expr

    INUM   shift, and go to state 13
    FNUM   shift, and go to state 14
    ID     shift, and go to state 3
    MINUS  shift, and go to state 15
    LP     shift, and go to state 16

    expr  go to state 30
    id    go to state 18


state 22

    7 declaration: INT id ASSIGN . INUM

    INUM  shift, and go to state 31


state 23

    8 declaration: FLOAT id ASSIGN . FNUM
    9            | FLOAT id ASSIGN . INUM

    INUM  shift, and go to state 32
    FNUM  shift, and go to state 33


state 24

   15 expr: expr . PLUS expr
   16     | expr . MINUS expr
   17     | expr . MUL expr
   18     | expr . DIV expr
   20     | MINUS expr .

    $default  reduce using rule 20 (expr)


state 25

   15 expr: expr . PLUS expr
   16     | expr . MINUS expr
   17     | expr . MUL expr
   18     | expr . DIV expr
   19     | LP expr . RP

    PLUS   shift, and go to state 26
    MINUS  shift, and go to state 27
    MUL    shift, and go to state 28
    DIV    shift, and go to state 29
    RP     shift, and go to state 34


state 26

   15 expr: expr PLUS . expr

    INUM   shift, and go to state 13
    FNUM   shift, and go to state 14
    ID     shift, and go to state 3
    MINUS  shift, and go to state 15
    LP     shift, and go to state 16

    expr  go to state 35
    id    go to state 18


state 27

   16 expr: expr MINUS . expr

    INUM   shift, and go to state 13
    FNUM   shift, and go to state 14
    ID     shift, and go to state 3
    MINUS  shift, and go to state 15
    LP     shift, and go to state 16

    expr  go to state 36
    id    go to state 18


state 28

   17 expr: expr MUL . expr

    INUM   shift, and go to state 13
    FNUM   shift, and go to state 14
    ID     shift, and go to state 3
    MINUS  shift, and go to state 15
    LP     shift, and go to state 16

    expr  go to state 37
    id    go to state 18


state 29

   18 expr: expr DIV . expr

    INUM   shift, and go to state 13
    FNUM   shift, and go to state 14
    ID     shift, and go to state 3
    MINUS  shift, and go to state 15
    LP     shift, and go to state 16

    expr  go to state 38
    id    go to state 18


state 30

   10 statement: id ASSIGN expr .
   15 expr: expr . PLUS expr
   16     | expr . MINUS expr
   17     | expr . MUL expr
   18     | expr . DIV expr

    PLUS   shift, and go to state 26
    MINUS  shift, and go to state 27
    MUL    shift, and go to state 28
    DIV    shift, and go to state 29

    $default  reduce using rule 10 (statement)


state 31

    7 declaration: INT id ASSIGN INUM .

    $default  reduce using rule 7 (declaration)


state 32

    9 declaration: FLOAT id ASSIGN INUM .

    $default  reduce using rule 9 (declaration)


state 33

    8 declaration: FLOAT id ASSIGN FNUM .

    $default  reduce using rule 8 (declaration)


state 34

   19 expr: LP expr RP .

    $default  reduce using rule 19 (expr)


state 35

   15 expr: expr . PLUS expr
   15     | expr PLUS expr .
   16     | expr . MINUS expr
   17     | expr . MUL expr
   18     | expr . DIV expr

    MUL  shift, and go to state 28
    DIV  shift, and go to state 29

    $default  reduce using rule 15 (expr)


state 36

   15 expr: expr . PLUS expr
   16     | expr . MINUS expr
   16     | expr MINUS expr .
   17     | expr . MUL expr
   18     | expr . DIV expr

    MUL  shift, and go to state 28
    DIV  shift, and go to state 29

    $default  reduce using rule 16 (expr)


state 37

   15 expr: expr . PLUS expr
   16     | expr . MINUS expr
   17     | expr . MUL expr
   17     | expr MUL expr .
   18     | expr . DIV expr

    $default  reduce using rule 17 (expr)


state 38

   15 expr: expr . PLUS expr
   16     | expr . MINUS expr
   17     | expr . MUL expr
   18     | expr . DIV expr
   18     | expr DIV expr .

    $default  reduce using rule 18 (expr)
